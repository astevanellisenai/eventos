<%- include('../includes/header', { titulo: 'Inscrições', usuario }) %>
<main class="conteudo">
    <div class="cabecalho-conteudo">
        <div>
            <h1>Inscrições</h1>
            <p>Gerencie as inscrições nos eventos.</p>
        </div>
        <a class="btn btn-primario" href="/inscricoes/novo">+ Nova inscrição</a>
    </div>

    <!-- Pesquisa e ordenação -->
    <form method="GET" action="/inscricoes"
          style="display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin:20px 0;">
        <input type="text" name="busca" placeholder="Pesquisar registros"
               value="<%= busca %>" style="padding:9px; min-width:240px;">
        <select name="ordem" style="padding:9px;">
            <option value="id" <%= ordem === 'id' ? 'selected' : '' %>>ID crescente</option>
            <option value="id_desc" <%= ordem === 'id_desc' ? 'selected' : '' %>>ID decrescente</option>
            <option value="participante" <%= ordem === 'participante' ? 'selected' : '' %>>Participante A-Z</option>
            <option value="evento" <%= ordem === 'evento' ? 'selected' : '' %>>Evento A-Z</option>
            <option value="status" <%= ordem === 'status' ? 'selected' : '' %>>Status A-Z</option>
        </select>
        <button type="submit" class="btn btn-primario">Pesquisar</button>
        <a href="/inscricoes" class="btn btn-muted">Limpar</a>
    </form>
    <p style="margin-bottom:12px;">Total encontrado: <strong><%= totalRegistros %></strong></p>

    <div class="tabela-container">
        <table>
            <thead>
                <tr>
                    <th>Participante</th>
                    <th>Evento</th>
                    <th>Status</th>
                    <th>Presente</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% inscricoes.forEach(inscricao => { %>
                    <tr>
                        <td><strong><%= inscricao.participante %></strong></td>
                        <td><%= inscricao.evento %></td>
                        <td><%= inscricao.status %></td>
                        <td><%= inscricao.presente ? 'Sim' : 'Não' %></td>
                        <td class="acoes">
                            <a class="btn btn-sucesso btn-sm"
                               href="/inscricoes/editar/<%= inscricao.id %>">Editar</a>
                            <form action="/inscricoes/excluir/<%= inscricao.id %>"
                                  method="POST"
                                  onsubmit="return confirm('Deseja realmente excluir esta inscrição?')">
                                <button class="btn btn-danger btn-sm"
                                        type="submit">Deletar</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
                <% if (inscricoes.length === 0) { %>
                    <tr>
                        <td colspan="5">Nenhuma inscrição cadastrada.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
    <!-- Paginação com preservação dos filtros -->
    <div style="display:flex; flex-wrap:wrap; gap:12px; align-items:center; margin:20px 0;">
        <% if (pagina > 1) { %>
            <a class="btn btn-secundario"
               href="/inscricoes?busca=<%= encodeURIComponent(busca) %>&ordem=<%= ordem %>&pagina=<%= pagina - 1 %>">Anterior</a>
        <% } %>
        <span>Página <strong><%= pagina %></strong> de <strong><%= totalPaginas %></strong></span>
        <% if (pagina < totalPaginas) { %>
            <a class="btn btn-secundario"
               href="/inscricoes?busca=<%= encodeURIComponent(busca) %>&ordem=<%= ordem %>&pagina=<%= pagina + 1 %>">Próxima</a>
        <% } %>
    </div>
</main>
<%- include('../includes/footer.ejs') %>
