<%- include('../includes/header', { titulo: 'Inscrições', usuario }) %>
<main class="conteudo">
    <div class="cabecalho-conteudo">
        <div>
            <h1>Inscrições</h1>
            <p>Gerencie as inscrições nos eventos.</p>
        </div>
        <a class="btn btn-primario" href="/inscricoes/novo">+ Nova inscrição</a>
    </div>

    <div class="tabela-container">
        <table>
            <thead>
                <tr>
                    <th>Participante</th>
                    <th>Evento</th>
                    <th>Status</th>
                    <th>Presente</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% inscricoes.forEach(inscricao => { %>
                    <tr>
                        <td><strong><%= inscricao.participante %></strong></td>
                        <td><%= inscricao.evento %></td>
                        <td><%= inscricao.status %></td>
                        <td><%= inscricao.presente ? 'Sim' : 'Não' %></td>
                        <td class="acoes">
                            <a class="btn btn-sucesso btn-sm"
                               href="/inscricoes/editar/<%= inscricao.id %>">Editar</a>
                            <form action="/inscricoes/excluir/<%= inscricao.id %>"
                                  method="POST"
                                  onsubmit="return confirm('Deseja realmente excluir esta inscrição?')">
                                <button class="btn btn-danger btn-sm"
                                        type="submit">Deletar</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
                <% if (inscricoes.length === 0) { %>
                    <tr>
                        <td colspan="5">Nenhuma inscrição cadastrada.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</main>
<%- include('../includes/footer.ejs') %>
