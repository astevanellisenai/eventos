<%- include("includes/header", { titulo: "Painel Administrativo" , usuario }) %>

    <main class="conteudo dashboard">

        <!-- CABEÇALHO DO DASHBOARD -->

        <h1>Dashboard</h1>

        <!-- INDICADORES -->
        <section class="dashboard-secao">
            <h2>Indicadores Gerais</h2>

            <div class="dashboard-indicadores">

                <div class="dashboard-card">
                    <h3>Eventos</h3>
                    <p>
                        <%= totalEventos %>
                    </p>
                </div>

                <div class="dashboard-card">
                    <h3>Participantes</h3>
                    <p>
                        <%= totalParticipantes %>
                    </p>
                </div>

                <div class="dashboard-card">
                    <h3>Inscrições</h3>
                    <p>
                        <%= totalInscricoes %>
                    </p>
                </div>

                <div class="dashboard-card">
                    <h3>Usuários Ativos</h3>
                    <p>
                        <%= usuariosAtivos %>
                    </p>
                </div>

            </div>
        </section>

        <!-- PRÓXIMOS EVENTOS -->
        <section class="dashboard-secao">
            <h2>Próximos Eventos</h2>

            <div class="table-wrap dashboard-tabela">
                <table>
                    <thead>
                        <tr>
                            <th>Evento</th>
                            <th>Data</th>
                            <th>Horário</th>
                            <th>Local</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% if (proximosEventos.length> 0) { %>

                            <% proximosEventos.forEach(evento=> { %>
                                <tr>
                                    <td>
                                        <%= evento.titulo %>
                                    </td>
                                    <td>
                                        <%= evento.data_evento %>
                                    </td>
                                    <td>
                                        <%= evento.horario %>
                                    </td>
                                    <td>
                                        <%= evento.local %>
                                    </td>
                                </tr>
                                <% }) %>

                                    <% } else { %>
                                        <tr>
                                            <td colspan="4">
                                                Nenhum evento disponível.
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- RESUMOS DO SISTEMA -->
        <section class="dashboard-secao">
            <h2>Resumo do Sistema</h2>

            <div class="dashboard-resumos">

                <!-- EVENTOS MAIS INSCRITOS -->
                <div class="dashboard-painel">
                    <h3>Eventos com Mais Inscrições</h3>

                    <% if (eventosMaisInscricoes.length> 0) { %>
                        <ol class="dashboard-lista">
                            <% eventosMaisInscricoes.forEach(evento=> { %>
                                <li>
                                    <span>
                                        <%= evento.titulo %>
                                    </span>
                                    <strong>
                                        <%= evento.total %>
                                    </strong>
                                </li>
                                <% }) %>
                        </ol>
                        <% } else { %>
                            <p class="dashboard-vazio">
                                Nenhuma inscrição encontrada.
                            </p>
                            <% } %>
                </div>

                <!-- INSCRIÇÕES POR STATUS -->
                <div class="dashboard-painel">
                    <h3>Inscrições por Status</h3>

                    <% if (inscricaoStatus.length> 0) { %>
                        <ul class="dashboard-lista">
                            <% inscricaoStatus.forEach(item=> { %>
                                <li>
                                    <span>
                                        <%= item.status %>
                                    </span>
                                    <strong>
                                        <%= item.total %>
                                    </strong>
                                </li>
                                <% }) %>
                        </ul>
                        <% } else { %>
                            <p class="dashboard-vazio">
                                Nenhuma inscrição encontrada.
                            </p>
                            <% } %>
                </div>

                <!-- EVENTOS POR CATEGORIA -->
                <div class="dashboard-painel">
                    <h3>Eventos por Categoria</h3>

                    <% if (eventosCategoria.length> 0) { %>
                        <ul class="dashboard-lista">
                            <% eventosCategoria.forEach(item=> { %>
                                <li>
                                    <span>
                                        <%= item.categoria %>
                                    </span>
                                    <strong>
                                        <%= item.total %>
                                    </strong>
                                </li>
                                <% }) %>
                        </ul>
                        <% } else { %>
                            <p class="dashboard-vazio">
                                Nenhuma categoria encontrada.
                            </p>
                            <% } %>
                </div>

            </div>
        </section>

    </main>

    <%- include("includes/footer") %>