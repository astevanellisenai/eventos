<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Eventos</title>
    <link rel="stylesheet" href="css/estilos-lp.css">
</head>

<body>
    <!--HERO-->
    <header class="cabecalho">
        <div class="container cabecalho-conteudo">
            <a href="#inicio" class="logo">
                <img src="img/landing/logo.png" alt="Sistema de eventos">
            </a>
            <nav class="menu">
                <a href="#sobre">
                    Sobre
                </a>
                <a href="#eventos">
                    Eventos
                </a>
                <a href="#diferenciais">
                    Diferenciais
                </a>
                <a href="#contato">
                    Contato
                </a>
                <a href="/login" class="botao-admin">
                    Área Administrativa
                </a>
            </nav>
        </div>
    </header>
    <main>
        <section class="hero" id="inicio">
            <div class="container hero-conteudo">
                <div class="hero-texto">
                    <h1>
                        Conhecimento, experiências
                        e oportunidades em um só lugar.
                    </h1>
                    <p>
                        Encontre palestras, workshops,
                        oficinas, encontros educacionais
                        e outras atividades promovidas
                        pela nossa instituição.
                    </p>
                    <div class="hero-botoes">
                        <a href="#eventos" class="botao botao-claro">Ver Eventos</a>
                        <a href="#contato" class="botao botao-transparente">Fale Conosco</a>
                    </div>
                </div>
                <div class="hero-imagem">
                    <img src="img/landing/hero-eventos.jpg" alt="Imagem de um evento">
                </div>
            </div>
        </section>
        <section class="sobre" id="sobre">
            <div class="container">
                <h2>Sobre a Instituição</h2>
                <p class="texto-sobre">
                    Nossa instituição realiza diferentes tipos de eventos ao longo do ano incluindo palestras,
                    workshops, oficinas, encontros educacionais, atividades culturais e ações voltadas à comunidade.
                </p>
                <p class="texto-sobre">
                    Este sistema foi criado para facilitar a divulgação dessas atividades e permitir que os participantes
                    encontrem informações sobre os eventos disponíveis.
                </p>
                <div class="cards-institucionais">
                    <article class="card-institucional">
                        <h3>Missão</h3>
                        <p>Promover conhecimento, experiências e oportunidades por meio de eventos acessíveis eorganizados.</p>
                    </article>
                    <article class="card-institucional">
                        <h3>Visão</h3>
                        <p>Ser referência na realização de eventos educacionais, profissionais e culturais voltados à comunidade.</p>
                    </article>
                    <article class="card-institucional">
                        <h3>Valores</h3>
                        <p>Educação, organização, inovação, colaboração, inclusão e compromisso com a comunidade.</p>
                    </article>
                </div>
            </div>
        </section>
        <section class="eventos" id="eventos">
            <div class="container">
                <div class="titulo-eventos">
                    <div>
                        <h2>Eventos Disponíveis</h2>
                        <p>Conheça os próximos eventos promovidos pela instituição.</p>
                    </div>
                </div>
                <div class="lista-eventos">
                    <% if (eventosAtivos.length> 0) { %>
                        <% eventosAtivos.forEach(evento=> { %>
                            <article class="card-evento">
                                <img src="img/upload/<%= evento.imagem_url %>" alt="<%= evento.titulo %>">
                                <div class="card-evento-conteudo">
                                    <span class="categoria"><%= evento.nome_categoria %></span>
                                    <h3><%= evento.titulo %></h3>
                                    <p><%= evento.descricao %></p>
                                    <div class="informacoes-evento">
                                        <p><strong>Data:</strong> <%= evento.data_formatada %></p>
                                        <p><strong>Horário:</strong> <%= evento.horario_formatado %></p>
                                        <p><strong>Local:</strong> <%= evento.local %></p>
                                        <p><strong>Organizador:</strong> <%= evento.nome_organizador %></p>
                                    </div>
                                </div>
                            </article>
                        <% }) %>
                    <% } else { %>
                        <p>Nenhum evento disponível no momento.</p>
                    <% } %>
                </div>
            </div>
        </section>
        <section class="diferenciais" id="diferenciais">
            <div class="container">
                <h2>Nossos Diferenciais</h2>
                <div class="lista-diferenciais">
                    <article class="card-diferencial">
                        <img src="img/landing/icon-organizacao.png" alt="Organização">
                        <h3>Organização</h3>
                        <p>Todos os eventos e suas principais informações disponíveis em um único local.</p>
                    </article>
                    <article class="card-diferencial">
                        <img src="img/landing/icon-diversidade.png" alt="Diversidade de eventos">
                        <h3>Diversidade</h3>
                        <p>Palestras, workshops, oficinas e atividades de diferentes categorias.</p>
                    </article>
                    <article class="card-diferencial">
                        <img src="img/landing/icon-comunidade.png" alt="Comunidade">
                        <h3>Comunidade</h3>
                        <p>Eventos que aproximam estudantes, profissionais, instituições e comunidade.</p>
                    </article>
                </div>
            </div>
        </section>
        <section class="contato" id="contato">
            <div class="container contato-conteudo">
                <div class="contato-informacoes">
                    <div>
                        <h2>Fale Conosco</h2>
                        <p>Possui alguma dúvida sobre nossos eventos?</p>
                        <p>Entre em contato com nossa equipe.</p>
                        <p class="dados-contato">
                            Rua Joaquim Caetano da Silva, 1601<br>
                            Mirandópolis/SP<br>
                            contato@eventos.com<br>
                            (18) 0000-0000
                        </p>
                    </div>
                    <img src="img/landing/mapa.png" alt="Mapa de localização" class="mapa">
                </div>
            </div>
        </section>
    </main>
    <footer class="rodape">
        <div class="container rodape-conteudo">
            <p>© <span id="ano"></span> Sistema de Eventos. Todos os direitos reservados.</p>
            <div class="rodape-links">
                <a href="/login">Área Administrativa</a>
            </div>
        </div>
    </footer>
</body>

</html>