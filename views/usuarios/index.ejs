<%- include('../includes/header', { titulo: 'Usuários' , usuario }) %>
    <main class="conteudo">
        <div class="cabecalho-conteudo">
            <div>
                <h1>Usuários</h1>
                <p>Gerencie os usuários e a situação de acesso.</p>
            </div>
            <a class="btn btn-primario" href="/usuarios/novo">+ Novo usuário</a>
        </div>
        <!-- Pesquisa e ordenação -->
        <form method="GET" action="/usuarios" class="barra-filtros">

            <input type="text" name="busca" class="campo-pesquisa" placeholder="Pesquisar registros"
                aria-label="Pesquisar registros" value="<%= busca %>">

            <select name="ordem" class="campo-ordenacao" aria-label="Ordenar registros">
                <option value="nome" <%=ordem==='nome' ? 'selected' : '' %>>Nome A-Z</option>
                <option value="nome_desc" <%=ordem==='nome_desc' ? 'selected' : '' %>>Nome Z-A</option>
                <option value="id" <%=ordem==='id' ? 'selected' : '' %>>ID crescente</option>
                <option value="id_desc" <%=ordem==='id_desc' ? 'selected' : '' %>>ID decrescente</option>
                <option value="situacao" <%=ordem==='situacao' ? 'selected' : '' %>>Ativos primeiro</option>
            </select>

            <button type="submit" class="btn btn-primario">
                Pesquisar
            </button>

            <a href="/usuarios" class="btn btn-muted">
                Limpar
            </a>

        </form>
        <p style="margin-bottom:12px;">Total encontrado: <strong>
                <%= totalRegistros %>
            </strong></p>

        <div class="tabela-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>E-mail</th>
                        <th>Situação</th>
                        <th>Data de cadastro</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% usuarios.forEach(u=> { %>
                        <tr>
                            <td>
                                <%= u.id %>
                            </td>
                            <td>
                                <strong>
                                    <%= u.nome %>
                                </strong>
                            </td>
                            <td>
                                <%= u.email %>
                            </td>
                            <td>
                                <span class="status <%= u.situacao===1?'status-ativo':'status-inativo' %>">
                                    <%= u.situacao===1?'Ativo':'Inativo' %>
                                </span>
                            </td>
                            <td>
                                <%= u.criado_em.toLocaleDateString('pt-BR') %>
                            </td>
                            <td class="acoes">
                                <form action="/usuarios/excluir/<%= u.id %>" method="POST"
                                    onsubmit="return confirm('Deseja realmente excluir esse usuario?')">

                                    <button type="submit" title="Excluir" class="btn btn-danger btn-sm">
                                        Deletar
                                    </button>
                                </form>
                                <a class="btn btn-sucesso btn-sm" href="/usuarios/editar/<%= u.id %>">
                                    Editar
                                </a>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>
        <!-- Paginação com preservação dos filtros -->
        <div class="paginacao">

            <% if (pagina> 1) { %>
                <a class="btn btn-secundario"
                    href="/usuarios?busca=<%= encodeURIComponent(busca) %>&ordem=<%= ordem %>&pagina=<%= pagina - 1 %>">
                    Anterior
                </a>
                <% } %>

                    <span class="paginacao-info">
                        Página <strong>
                            <%= pagina %>
                        </strong>
                        de <strong>
                            <%= totalPaginas %>
                        </strong>
                    </span>

                    <% if (pagina < totalPaginas) { %>
                        <a class="btn btn-secundario"
                            href="/usuarios?busca=<%= encodeURIComponent(busca) %>&ordem=<%= ordem %>&pagina=<%= pagina + 1 %>">
                            Próxima
                        </a>
                        <% } %>

        </div>
    </main>
    <%- include('../includes/footer.ejs') %>