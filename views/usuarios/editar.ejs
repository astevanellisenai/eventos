<%- include('../includes/header', { titulo: 'Editar usuário', usuario }) %>
<main class="conteudo">
    <div class="cabecalho-conteudo">
        <div>
            <h1>Editar usuário</h1>
            <p>Atualize os dados do usuário.</p>
        </div>
    </div>
    <div class="card">
        <form action="/usuarios/editar/<%= usuarioEditado.id %>" method="POST">
            <div class="campo-formulario">
                <label for="nome">Nome</label>
                <input type="text" id="nome" name="nome" value="<%= usuarioEditado.nome %>" required>
            </div>
            <div class="campo-formulario">
                <label for="email">E-mail</label>
                <input type="email" id="email" name="email" value="<%= usuarioEditado.email %>" required>
            </div>
            <div class="campo-formulario">
                <label for="senha">Senha</label>
                <input type="password" id="senha" name="senha" value="<%= usuarioEditado.senha %>" required>
            </div>
            <div class="campo-formulario">
                <label for="situacao">Situação</label>
                <select id="situacao" name="situacao">
                    <option value="1" <%= usuarioEditado.situacao == 1 ? 'selected' : '' %>>Ativo</option>
                    <option value="0" <%= usuarioEditado.situacao == 0 ? 'selected' : '' %>>Inativo</option>
                </select>
            </div>
            <div class="botoes-formulario">
                <a class="btn btn-muted" href="/usuarios">Cancelar</a>
                <button class="btn btn-primario" type="submit">Atualizar</button>
            </div>
        </form>
    </div>
</main>
<%- include('../includes/footer.ejs') %>
