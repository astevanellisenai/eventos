<%- include('../includes/header', { titulo: 'Cadastrar usuário' , usuario }) %>
    <main class="conteudo">
        <div class="cabecalho-conteudo">
            <div>
                <h1>Cadastrar usuário</h1>
                <p>Cadastre um novo usuário.</p>
            </div>
        </div>
        <div class="card">
            <form action="/usuarios/novo" method="POST">
                <div class="linha-formulario">
                    <div class="campo-formulario">
                        <label for="nome">Nome Completo</label>
                        <input type="text" id="nome" name="nome" required maxlength="100" minlength="3"
                            placeholder="Digite o nome">
                    </div>
                    <div class="campo-formulario">
                        <label>Situação</label>
                        <select name="situacao" required>
                            <option value="1">Ativo</option>
                            <option value="0">Inativo</option>
                        </select>
                    </div>
                </div>
                <div class="linha-formulario" style="margin-top:16px">
                    <div class="campo-formulario">
                        <label for="email">E-mail</label>
                        <input type="email" id="email" name="email" placeholder="adm@email.com" required maxlength="150"
                            minlength="3">
                    </div>
                    <div class="campo-formulario">
                        <label for="senha">Senha</label>
                        <input type="password" id="senha" name="senha" placeholder="Digite a senha" required
                            maxlength="255" minlength="3">
                    </div>
                </div>
                <div class="botoes-formulario">
                    <a class="btn btn-muted" href="/usuarios">
                        Cancelar
                    </a>
                    <button class="btn btn-primario" type="submit">
                        Salvar
                    </button>
                </div>
            </form>
        </div>
    </main>
    <%- include('../includes/footer.ejs') %>