<%- include('../includes/header', { titulo: 'Eventos', usuario }) %>
<main class="conteudo">
    <div class="cabecalho-conteudo">
        <div>
            <h1>Eventos</h1>
            <p>Gerencie os eventos e seus organizadores.</p>
        </div>
        <a class="btn btn-primario" href="/eventos/novo">+ Novo evento</a>
    </div>
    <!-- Pesquisa e ordenação -->
    <form method="GET" action="/eventos"
          style="display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin:20px 0;">
        <input type="text" name="busca" placeholder="Pesquisar registros"
               value="<%= busca %>" style="padding:9px; min-width:240px;">
        <select name="ordem" style="padding:9px;">
            <option value="data" <%= ordem === 'data' ? 'selected' : '' %>>Data crescente</option>
            <option value="data_desc" <%= ordem === 'data_desc' ? 'selected' : '' %>>Data decrescente</option>
            <option value="titulo" <%= ordem === 'titulo' ? 'selected' : '' %>>Título A-Z</option>
            <option value="titulo_desc" <%= ordem === 'titulo_desc' ? 'selected' : '' %>>Título Z-A</option>
            <option value="id" <%= ordem === 'id' ? 'selected' : '' %>>ID crescente</option>
            <option value="id_desc" <%= ordem === 'id_desc' ? 'selected' : '' %>>ID decrescente</option>
        </select>
        <button type="submit" class="btn btn-primario">Pesquisar</button>
        <a href="/eventos" class="btn btn-muted">Limpar</a>
    </form>
    <p style="margin-bottom:12px;">Total encontrado: <strong><%= totalRegistros %></strong></p>

    <div class="tabela-container">
        <table>
            <thead>
                <tr><th>Evento</th><th>Data / Horário</th><th>Local</th><th>Vagas</th><th>Categoria</th><th>Organizador</th><th>Ações</th></tr>
            </thead>
            <tbody>
                <% eventos.forEach(evento => { %>
                    <tr>
                        <td>
                            <strong><%= evento.titulo %></strong>
                            <p><%= evento.descricao || '' %></p>
                        </td>
                        <td><%= new Date(evento.data_evento).toLocaleDateString('pt-BR', { timeZone: 'UTC' }) %> <%= String(evento.horario).slice(0,5) %></td>
                        <td><%= evento.local %></td>
                        <td><%= evento.quantidade_vagas %></td>
                        <td><%= evento.categoria %></td>
                        <td><%= evento.organizador %></td>
                        <td class="acoes">
                            <a class="btn btn-sucesso btn-sm" href="/eventos/editar/<%= evento.id %>">Editar</a>
                            <a class="btn btn-danger btn-sm" href="/eventos/excluir/<%= evento.id %>"
                               onclick="return confirm('Deseja realmente excluir este evento?')">Deletar</a>
                        </td>
                    </tr>
                <% }) %>
                <% if (eventos.length === 0) { %>
                    <tr><td colspan="7">Nenhum evento cadastrado.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
    <!-- Paginação com preservação dos filtros -->
    <div style="display:flex; flex-wrap:wrap; gap:12px; align-items:center; margin:20px 0;">
        <% if (pagina > 1) { %>
            <a class="btn btn-secundario"
               href="/eventos?busca=<%= encodeURIComponent(busca) %>&ordem=<%= ordem %>&pagina=<%= pagina - 1 %>">Anterior</a>
        <% } %>
        <span>Página <strong><%= pagina %></strong> de <strong><%= totalPaginas %></strong></span>
        <% if (pagina < totalPaginas) { %>
            <a class="btn btn-secundario"
               href="/eventos?busca=<%= encodeURIComponent(busca) %>&ordem=<%= ordem %>&pagina=<%= pagina + 1 %>">Próxima</a>
        <% } %>
    </div>
</main>
<%- include('../includes/footer.ejs') %>
