<%-include("../includes/header", {titulo: "Eventos", usuario}) %>
<h1>Lista de Eventos</h1>

<a href="/admin">Voltar</a>

<br><br>

<a href="/eventos/novo">
    Novo Evento
</a>

<hr>

<% eventos.forEach(evento=> { %>

    <h2>
        <%= evento.titulo %>
    </h2>

    <p>
        <strong>Descrição:</strong>
        <%= evento.descricao %>
    </p>

    <p>
        <strong>Data:</strong>
        <%= evento.data_evento %>
    </p>

    <p>
        <strong>Horário:</strong>
        <%= evento.horario %>
    </p>

    <p>
        <strong>Local:</strong>
        <%= evento.local %>
    </p>

    <p>
        <strong>Vagas:</strong>
        <%= evento.quantidade_vagas %>
    </p>

    <p>
        <strong>Categoria:</strong>
        <%= evento.categoria %>
    </p>

    <p>
        <strong>Organizador:</strong>
        <%= evento.organizador %>
    </p>

    <p>
        <a href="/eventos/editar/<%= evento.id %>">
            Editar
        </a>

        |

        <a href="/eventos/excluir/<%= evento.id %>">
            Excluir
        </a>
    </p>

    <hr>

    <% }) %>

<%-include("../includes/footer") %>