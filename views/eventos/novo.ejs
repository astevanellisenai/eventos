<%- include('../includes/header', { titulo: 'Cadastrar evento', usuario }) %>
<main class="conteudo">
    <div class="cabecalho-conteudo">
        <div>
            <h1>Cadastrar evento</h1>
            <p>Cadastre um novo evento.</p>
        </div>
    </div>
    <div class="card">
        <form action="/eventos/novo" method="POST">
            <div class="campo-formulario">
                <label for="titulo">Título</label>
                <input type="text" id="titulo" name="titulo" required>
            </div>
            <div class="campo-formulario">
                <label for="descricao">Descrição</label>
                <textarea id="descricao" name="descricao" rows="4"></textarea>
            </div>
            <div class="campo-formulario">
                <label for="data_evento">Data</label>
                <input type="date" id="data_evento" name="data_evento" required>
            </div>
            <div class="campo-formulario">
                <label for="horario">Horário</label>
                <input type="time" id="horario" name="horario" required>
            </div>
            <div class="campo-formulario">
                <label for="local">Local</label>
                <input type="text" id="local" name="local" required>
            </div>
            <div class="campo-formulario">
                <label for="quantidade_vagas">Quantidade de vagas</label>
                <input type="number" id="quantidade_vagas" name="quantidade_vagas" min="1" required>
            </div>
            <div class="campo-formulario">
                <label for="imagem_url">URL da imagem</label>
                <input type="text" id="imagem_url" name="imagem_url" >
            </div>
            <div class="campo-formulario">
                <label for="categoria_id">Categoria</label>
                <select id="categoria_id" name="categoria_id" required>
                    <option value="">Selecione</option>
                    <% categorias.forEach(item => { %>
                        <option value="<%= item.id %>" ><%= item.nome %></option>
                    <% }) %>
                </select>
            </div>
            <div class="campo-formulario">
                <label for="organizador_id">Organizador</label>
                <select id="organizador_id" name="organizador_id" required>
                    <option value="">Selecione</option>
                    <% usuarios.forEach(item => { %>
                        <option value="<%= item.id %>" ><%= item.nome %></option>
                    <% }) %>
                </select>
            </div>
            <div class="botoes-formulario">
                <a class="btn btn-muted" href="/eventos">Cancelar</a>
                <button class="btn btn-primario" type="submit">Salvar</button>
            </div>
        </form>
    </div>
</main>
<%- include('../includes/footer.ejs') %>
