<%- include('../includes/header', { titulo: 'Participantes', usuario }) %>
<main class="conteudo">
    <div class="cabecalho-conteudo">
        <div>
            <h1>Participantes</h1>
            <p>Gerencie os participantes cadastrados.</p>
        </div>
        <a class="btn btn-primario" href="/participantes/novo">+ Novo participante</a>
    </div>
    <div class="tabela-container">
        <table>
            <thead>
                <tr><th>ID</th><th>Nome</th><th>E-mail</th><th>Telefone</th><th>Ações</th></tr>
            </thead>
            <tbody>
                <% participantes.forEach(participante => { %>
                    <tr>
                        <td><%= participante.id %></td>
                        <td><strong><%= participante.nome %></strong></td>
                        <td><%= participante.email %></td>
                        <td><%= participante.telefone || '-' %></td>
                        <td class="acoes">
                            <a class="btn btn-sucesso btn-sm" href="/participantes/editar/<%= participante.id %>">Editar</a>
                            <a class="btn btn-danger btn-sm" href="/participantes/excluir/<%= participante.id %>"
                               onclick="return confirm('Deseja realmente excluir este participante?')">Deletar</a>
                        </td>
                    </tr>
                <% }) %>
                <% if (participantes.length === 0) { %>
                    <tr><td colspan="5">Nenhum participante cadastrado.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</main>
<%- include('../includes/footer.ejs') %>
