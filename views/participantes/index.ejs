<%- include('../includes/header', { titulo: 'Participantes' , usuario }) %>
    <main class="conteudo">
        <div class="cabecalho-conteudo">
            <div>
                <h1>Participantes</h1>
                <p>Gerencie os participantes cadastrados.</p>
            </div>
            <a class="btn btn-primario" href="/participantes/novo">+ Novo participante</a>
        </div>
        <!-- Pesquisa e ordenação -->
        <form method="GET" action="/participantes" class="barra-filtros">

            <input type="text" name="busca" class="campo-pesquisa" placeholder="Pesquisar registros"
                value="<%= busca %>">

            <select name="ordem" class="campo-ordenacao">
                <option value="nome" <%=ordem==='nome' ? 'selected' : '' %>>Nome A-Z</option>
                <option value="nome_desc" <%=ordem==='nome_desc' ? 'selected' : '' %>>Nome Z-A</option>
                <option value="id" <%=ordem==='id' ? 'selected' : '' %>>ID crescente</option>
                <option value="id_desc" <%=ordem==='id_desc' ? 'selected' : '' %>>ID decrescente</option>
            </select>

            <button type="submit" class="btn btn-primario">
                Pesquisar
            </button>

            <a href="/participantes" class="btn btn-muted">
                Limpar
            </a>

        </form>
        <p style="margin-bottom:12px;">Total encontrado: <strong>
                <%= totalRegistros %>
            </strong></p>

        <div class="tabela-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>E-mail</th>
                        <th>Telefone</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% participantes.forEach(participante=> { %>
                        <tr>
                            <td>
                                <%= participante.id %>
                            </td>
                            <td><strong>
                                    <%= participante.nome %>
                                </strong></td>
                            <td>
                                <%= participante.email %>
                            </td>
                            <td>
                                <%= participante.telefone || '-' %>
                            </td>
                            <td class="acoes">
                                <a class="btn btn-sucesso btn-sm"
                                    href="/participantes/editar/<%= participante.id %>">Editar</a>
                                <a class="btn btn-danger btn-sm" href="/participantes/excluir/<%= participante.id %>"
                                    onclick="return confirm('Deseja realmente excluir este participante?')">Deletar</a>
                            </td>
                        </tr>
                        <% }) %>
                            <% if (participantes.length===0) { %>
                                <tr>
                                    <td colspan="5">Nenhum participante cadastrado.</td>
                                </tr>
                                <% } %>
                </tbody>
            </table>
        </div>
        <!-- Paginação com preservação dos filtros -->

        <!-- Paginação -->
        <div class="paginacao">

            <% if (pagina> 1) { %>
                <a class="btn btn-secundario"
                    href="/participantes?busca=<%= encodeURIComponent(busca) %>&ordem=<%= ordem %>&pagina=<%= pagina - 1 %>">
                    Anterior
                </a>
                <% } %>

                    <span class="paginacao-info">
                        Página <strong>
                            <%= pagina %>
                        </strong>
                        de <strong>
                            <%= totalPaginas %>
                        </strong>
                    </span>

                    <% if (pagina < totalPaginas) { %>
                        <a class="btn btn-secundario"
                            href="/participantes?busca=<%= encodeURIComponent(busca) %>&ordem=<%= ordem %>&pagina=<%= pagina + 1 %>">
                            Próxima
                        </a>
                        <% } %>

        </div>

    </main>
    <%- include('../includes/footer.ejs') %>