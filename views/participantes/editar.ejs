<%- include('../includes/header', { titulo: 'Editar participante', usuario }) %>
<main class="conteudo">
    <div class="cabecalho-conteudo">
        <div>
            <h1>Editar participante</h1>
            <p>Atualize os dados do participante.</p>
        </div>
    </div>
    <div class="card">
        <form action="/participantes/editar/<%= participante.id %>" method="POST">
            <div class="campo-formulario">
                <label for="nome">Nome</label>
                <input type="text" id="nome" name="nome" value="<%= participante.nome %>" required>
            </div>
            <div class="campo-formulario">
                <label for="email">E-mail</label>
                <input type="email" id="email" name="email" value="<%= participante.email %>" required>
            </div>
            <div class="campo-formulario">
                <label for="telefone">Telefone</label>
                <input type="text" id="telefone" name="telefone" value="<%= participante.telefone || '' %>" >
            </div>
            <div class="botoes-formulario">
                <a class="btn btn-muted" href="/participantes">Cancelar</a>
                <button class="btn btn-primario" type="submit">Atualizar</button>
            </div>
        </form>
    </div>
</main>
<%- include('../includes/footer.ejs') %>
