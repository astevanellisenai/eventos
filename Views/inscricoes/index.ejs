<h1>Lista de Inscrições</h1>

<a href="/admin">Voltar</a>

<br><br>

<a href="/inscricoes/novo">
    Nova Inscrição
</a>

<hr>

<% inscricoes.forEach(inscricao=> { %>

    <h2>
        <%= inscricao.participante %>
    </h2>

    <p>
        <strong>Evento:</strong>
        <%= inscricao.evento %>
    </p>

    <p>
        <strong>Status:</strong>
        <%= inscricao.status %>
    </p>

    <p>
        <strong>Presente:</strong>
        <%= inscricao.presente ? 'Sim' : 'Não' %>
    </p>

    <p>
        <a href="/inscricoes/editar/<%= inscricao.id %>">
            Editar
        </a>
    </p>

    <form action="/inscricoes/excluir/<%= inscricao.id %>" method="POST">

        <button type="submit">
            Excluir
        </button>

    </form>

    <hr>

    <% }) %>