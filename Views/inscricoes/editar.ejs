<h1>Editar Inscrição</h1>

<a href="/inscricoes">Voltar</a>

<hr>

<form action="/inscricoes/editar/<%= inscricao.id %>" method="POST">

    <p>
        <label>Participante:</label><br>

        <select
            name="participante_id"
            required
        >

            <% participantes.forEach(participante => { %>

                <option
                    value="<%= participante.id %>"
                    <%= participante.id == inscricao.participante_id ? 'selected' : '' %>
                >

                    <%= participante.nome %>

                </option>

            <% }) %>

        </select>
    </p>

    <p>
        <label>Evento:</label><br>

        <select
            name="evento_id"
            required
        >

            <% eventos.forEach(evento => { %>

                <option
                    value="<%= evento.id %>"
                    <%= evento.id == inscricao.evento_id ? 'selected' : '' %>
                >

                    <%= evento.titulo %>

                </option>

            <% }) %>

        </select>
    </p>

    <p>
        <label>Status:</label><br>

        <select
            name="status"
            required
        >

            <option
                value="pendente"
                <%= inscricao.status == 'pendente' ? 'selected' : '' %>
            >
                Pendente
            </option>

            <option
                value="confirmada"
                <%= inscricao.status == 'confirmada' ? 'selected' : '' %>
            >
                Confirmada
            </option>

            <option
                value="cancelada"
                <%= inscricao.status == 'cancelada' ? 'selected' : '' %>
            >
                Cancelada
            </option>

        </select>
    </p>

    <p>
        <label>Presente:</label><br>

        <select name="presente">

            <option
                value="false"
                <%= !inscricao.presente ? 'selected' : '' %>
            >
                Não
            </option>

            <option
                value="true"
                <%= inscricao.presente ? 'selected' : '' %>
            >
                Sim
            </option>

        </select>
    </p>

    <button type="submit">
        Atualizar
    </button>

</form>