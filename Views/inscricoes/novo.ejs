<h1>Nova Inscrição</h1>

<a href="/inscricoes">Voltar</a>

<hr>

<form action="/inscricoes/novo" method="POST">

    <p>
        <label>Participante:</label><br>

        <select name="participante_id" required>

            <option value="">
                Selecione
            </option>

            <% participantes.forEach(participante=> { %>

                <option value="<%= participante.id %>">

                    <%= participante.nome %>

                </option>

                <% }) %>

        </select>
    </p>

    <p>
        <label>Evento:</label><br>

        <select name="evento_id" required>

            <option value="">
                Selecione
            </option>

            <% eventos.forEach(evento=> { %>

                <option value="<%= evento.id %>">

                    <%= evento.titulo %>

                </option>

                <% }) %>

        </select>
    </p>

    <p>
        <label>Status:</label><br>

        <select name="status" required>

            <option value="pendente">
                Pendente
            </option>

            <option value="confirmada">
                Confirmada
            </option>

            <option value="cancelada">
                Cancelada
            </option>

        </select>
    </p>

    <p>
        <label>Presente:</label><br>

        <select name="presente">

            <option value="false">
                Não
            </option>

            <option value="true">
                Sim
            </option>

        </select>
    </p>

    <button type="submit">
        Salvar
    </button>

</form>