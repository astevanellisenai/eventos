<h1>Editar Usuário</h1>

<a href="/usuarios">Voltar</a>

<hr>

<form action="/usuarios/editar/<%= usuario.id %>" method="POST">

    <p>
        <label>Nome:</label><br>

        <input
            type="text"
            name="nome"
            value="<%= usuario.nome %>"
            required
        >
    </p>

    <p>
        <label>E-mail:</label><br>

        <input
            type="email"
            name="email"
            value="<%= usuario.email %>"
            required
        >
    </p>

    <p>
        <label>Senha:</label><br>

        <input
            type="text"
            name="senha"
            value="<%= usuario.senha %>"
            required
        >
    </p>

    <p>
        <label>Situação:</label><br>

        <select name="situacao">

            <option
                value="1"
                <%= usuario.situacao == 1 ? 'selected' : '' %>
            >
                Ativo
            </option>

            <option
                value="0"
                <%= usuario.situacao == 0 ? 'selected' : '' %>
            >
                Inativo
            </option>

        </select>
    </p>

    <button type="submit">
        Atualizar
    </button>

</form>