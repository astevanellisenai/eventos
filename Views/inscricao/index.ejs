<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Inscrições</title>

</head>

<body>

    <h1>Inscrições</h1>

    <a href="/inscricoes/novo">
        Nova Inscrição
    </a>

    <br><br>

    <table border="1" cellpadding="10" cellspacing="0">

        <thead>

            <tr>

                <th>ID</th>
                <th>Participante</th>
                <th>Evento</th>
                <th>Status</th>
                <th>Presente</th>
                <th>Ações</th>

            </tr>

        </thead>

        <tbody>

            <% inscricoes.forEach(inscricao=> { %>

                <tr>

                    <td>
                        <%= inscricao.id %>
                    </td>

                    <td>
                        <%= inscricao.participante %>
                    </td>

                    <td>
                        <%= inscricao.evento %>
                    </td>

                    <td>
                        <%= inscricao.status %>
                    </td>

                    <td>

                        <% if (inscricao.presente) { %>

                            Sim

                            <% } else { %>

                                Não

                                <% } %>

                    </td>

                    <td>

                        <a href="/inscricoes/editar/<%= inscricao.id %>">
                            Editar
                        </a>

                        |

                        <form action="/inscricoes/excluir/<%= inscricao.id %>" method="POST" style="display:inline;"
                            onsubmit="return confirm('Deseja excluir esta inscrição?')">

                            <button type="submit">
                                Excluir
                            </button>

                        </form>

                    </td>

                </tr>

                <% }) %>

        </tbody>

    </table>

    <br>

    <a href="/admin">
        Voltar
    </a>

</body>

</html>