<h1>Editar Categoria</h1>

<a href="/categorias">Voltar</a>

<hr>
<form action="/categorias/editar/<%= categoria.id %>" method="POST">

    <p>
        <label>Nome:</label><br>

        <input type="text" name="nome" value="<%= categoria.nome %>" required>
    </p>

    <p>
        <label>Descrição:</label><br>

        <textarea name="descricao" rows="5" cols="40"><%= categoria.descricao %></textarea>
    </p>

    <button type="submit">
        Salvar Alterações
    </button>

</form>